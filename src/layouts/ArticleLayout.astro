---
import BaseLayout from "./BaseLayout.astro";
import ArrowLeft from "../assets/icons/arrow-left.svg";

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <div class="prose mx-auto max-w-4xl px-6 py-14 pb-20 pt-8 lg:py-20">
    <div class="mb-12">
      <a
        href="/articles"
        class="text-sky-700 hover:text-sky-600 no-underline hover:underline flex items-center font-semibold"
        ><ArrowLeft class="mr-2 w-5" />Back to articles</a
      >
    </div>
    <slot />
  </div>
</BaseLayout>
