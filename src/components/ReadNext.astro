---
import ReadMoreButton from "./ReadMoreButton.astro";

interface Props {
  articles: {
    title: string;
    description: string;
    slug: string;
  }[];
  heading?: string;
  pretitle?: string;
}

const { articles, heading = "Read next", pretitle = "More articles" } = Astro.props;
---

<section class="mx-auto mt-16 max-w-7xl px-6">
  <div class="mb-8 max-w-4xl">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700">
      {pretitle}
    </p>
    <h2 class="mt-2 text-3xl font-semibold text-slate-900">{heading}</h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {
      articles.map((article) => (
        <article class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]">
          <div class="relative">
            <a href={`/articles/${article.slug}`} class="absolute inset-0 text-[0px]" />
            <div class="p-6 pb-10">
              <h3 class="mt-3 text-xl font-semibold text-slate-900">
                {article.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">
                {article.description}
              </p>
              <ReadMoreButton href={`/articles/${article.slug}`} />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
