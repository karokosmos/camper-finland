---
import ReadMoreButton from "./ReadMoreButton.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  guides: {
    title: string;
    description: string;
    slug: string;
    mainImage: ImageMetadata;
  }[];
}

const { guides } = Astro.props;
---

<section class="mx-auto mt-16">
  <h3 class="font-semibold">Read next</h3>

  <div class="mt-6 flex flex-wrap justify-start gap-6">
    {
      guides.map((guide) => (
        <article class="flex h-full flex-col w-full max-w-[22rem] rounded-[1.5rem] border border-slate-200 bg-white shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]">
            <a
              href={`/guides/${guide.slug}/`}
              class="absolute inset-0 text-[0px]"
            />
            <Image
              src={guide.mainImage}
              alt={`${guide.title} cover`}
              class="h-44 w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-6 pb-10">
              <h3 class="mt-3 text-xl font-semibold text-slate-900">
                {guide.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">
                {guide.description}
              </p>
              <ReadMoreButton href={`/guides/${guide.slug}/`} />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
