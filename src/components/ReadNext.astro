---
import ReadMoreButton from "./ReadMoreButton.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  articles: {
    title: string;
    description: string;
    slug: string;
    mainImage: ImageMetadata;
  }[];
}

const { articles } = Astro.props;
---

<section class="mx-auto mt-16">
  <h3 class="font-semibold">Read next</h3>

  <div class="mt-6 flex flex-wrap justify-start gap-6">
    {
      articles.map((article) => (
        <article class="w-full max-w-[22rem] rounded-[1.5rem] border border-slate-200 bg-white shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]">
            <a
              href={`/articles/${article.slug}`}
              class="absolute inset-0 text-[0px]"
            />
            <Image
              src={article.mainImage}
              alt={`${article.title} cover`}
              class="h-44 w-full object-cover"
            />
            <div class="p-6 pb-10">
              <h3 class="mt-3 text-xl font-semibold text-slate-900">
                {article.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">
                {article.description}
              </p>
              <ReadMoreButton href={`/articles/${article.slug}`} />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
