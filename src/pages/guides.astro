---
import "../styles/global.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ReadMoreButton from "../components/ReadMoreButton.astro";
import { Image } from "astro:assets";

const allGuides = await getCollection("guide");
const featuredGuide = allGuides.find((guide) => guide.data.featured);
const guides = allGuides.filter((guide) => !guide.data.featured);
---

<BaseLayout pageTitle="Practical tips and road trip guides">
  <main>
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-20">
      <h1 class="mt-4 text-4xl font-semibold text-slate-900 sm:text-5xl">
        Camping guides for Finland
      </h1>
    </div>
    <div class="mx-auto max-w-7xl px-6 pb-20 mb-12">
      {
        featuredGuide && (
          <article class="flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_24px_80px_-28px_rgba(15,23,42,0.15)]">
            <div class="grid lg:grid-cols-[1fr_1fr] relative">
              <a
                href={`/guides/${featuredGuide?.data.slug}`}
                class="absolute inset-0 text-[0px]"
              />
              <Image
                src={featuredGuide.data.mainImage}
                alt={`${featuredGuide.data.title} cover`}
                class="h-120 w-full object-cover"
              />
              <div class="flex flex-1 flex-col p-10 lg:px-12 lg:py-14">
                {/*<p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">
                  Featured guide
                </p>*/}
                <h2 class="mt-4 text-3xl font-semibold text-slate-900 sm:text-4xl">
                  {featuredGuide?.data.title}
                </h2>
                <p class="mt-4 text-base leading-8 text-slate-600">
                  {featuredGuide?.data.description}
                </p>
                <ReadMoreButton href={`/guides/${featuredGuide?.data.slug}`} />
              </div>
            </div>
          </article>
        )
      }

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          guides.map((guide) => (
            <article class="flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]">
              <div class="relative">
                <a
                  href={`/guides/${guide.data.slug}`}
                  class="absolute inset-0 text-[0px]"
                />
                <Image
                  src={guide.data.mainImage}
                  alt={`${guide.data.title} cover`}
                  class="h-56 w-full object-cover"
                />
                <div class="flex flex-1 flex-col p-7 pb-12">
                  {/*<p class="text-sm font-semibold text-sky-700">Summer route</p>*/}
                  <h2 class="mt-3 text-2xl font-semibold text-slate-900">
                    {guide.data.title}
                  </h2>
                  <p class="mt-3 text-base leading-7 text-slate-600 ">
                    {guide.data.description}
                  </p>
                  <ReadMoreButton href={`/guides/${guide.data.slug}`} />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
