---
import "../styles/global.css";

import Layout from "../layouts/BaseLayout.astro";
import camper from "../assets/camper.jpg";
import flag from "../assets/finland_flag.png";
---

<Layout>
  <main class="text-slate-900">
    <section
      class="mx-auto grid max-w-7xl gap-10 px-6 py-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-20"
    >
      <div class="space-y-8">
        <div class="space-y-5">
          <h1
            class="max-w-2xl text-4xl font-semibold leading-tight text-slate-900 sm:text-5xl"
          >
            Your guide to RV, caravan & campervan travel in Finland
            <img
              src={flag.src}
              alt="Finnish flag"
              class="ml-2 inline h-7 w-9 rounded-sm align-baseline shadow-lg"
            />
          </h1>

          <p class="max-w-xl text-lg leading-8 text-slate-600">
            Discover helpful information, planning tips and travel inspiration
            for your next Finnish road trip.
          </p>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="#articles"
            class="inline-flex items-center justify-center rounded-full bg-sky-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-sky-700"
          >
            Explore articles
          </a>
          <a
            href="#about"
            class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-sky-700 hover:text-sky-700"
          >
            Learn more
          </a>
        </div>

        <!--<
        <dl class="grid gap-4 pt-2 sm:grid-cols-3">
          <div class="rounded-2xl border border-slate-100 bg-white/80 px-4 py-3 shadow-sm">
            <dt class="text-sm text-slate-500">Routes</dt>
            <dd class="mt-1 text-lg font-semibold text-slate-900">Coastal & lake journeys</dd>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white/80 px-4 py-3 shadow-sm">
            <dt class="text-sm text-slate-500">Campsites</dt>
            <dd class="mt-1 text-lg font-semibold text-slate-900">Hidden gems & essentials</dd>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white/80 px-4 py-3 shadow-sm">
            <dt class="text-sm text-slate-500">Tips</dt>
            <dd class="mt-1 text-lg font-semibold text-slate-900">Planning for all seasons</dd>
          </div>
        </dl>
        -->
      </div>

      <div
        class="relative overflow-hidden rounded-[1.75rem] border border-slate-100 bg-white shadow-[0_24px_80px_-24px_rgba(15,23,42,0.18)]"
      >
        <img
          src={camper.src}
          alt="Campervan parked by a Finnish lake"
          class="h-full w-full object-cover sm:h-[520px]"
        />
      </div>
    </section>

    <section id="articles" class="mx-auto max-w-7xl px-6 pb-20 pt-8">
      <div class="mb-8 max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700"
        >
          Articles
        </p>
        <h2 class="mt-2 text-3xl font-semibold text-slate-900">
          Practical tips and road trip guides
        </h2>
        <!--
        <p class="mt-3 text-base leading-7 text-slate-600">
          Explore preparation, planning and on-the-road tips written for
          campers, caravaners, and RV travelers.
        </p>
        -->
      </div>

      <div class="mb-24 grid gap-6 md:grid-cols-3">
        <article
          class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]"
        >
          <p class="text-sm font-semibold text-sky-700">Summer route</p>
          <h3 class="mt-3 text-xl font-semibold text-slate-900">
            A relaxed lake-loop itinerary in Finland
          </h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            Discover a scenic, stress-free plan for stopping at forests,
            lakeside campsites, and local food stops along the way.
          </p>
          <a
            href="#"
            class="mt-5 inline-flex text-sm font-semibold text-sky-700"
            >Read more</a
          >
        </article>

        <article
          class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]"
        >
          <p class="text-sm font-semibold text-sky-700">Camp setup</p>
          <h3 class="mt-3 text-xl font-semibold text-slate-900">
            What to pack for a comfortable campervan trip
          </h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            A practical checklist for weather, cooking, sleeping, and everyday
            essentials so your trip feels easy from the first mile.
          </p>
          <a
            href="#"
            class="mt-5 inline-flex text-sm font-semibold text-sky-700"
            >Read more</a
          >
        </article>

        <article
          class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]"
        >
          <p class="text-sm font-semibold text-sky-700">Hidden gems</p>
          <h3 class="mt-3 text-xl font-semibold text-slate-900">
            The best quiet places to stop for the night
          </h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            A short guide to peaceful overnight stops, local nature spots, and
            the simple pleasures of traveling slowly in Finland.
          </p>
          <a
            href="#"
            class="mt-5 inline-flex text-sm font-semibold text-sky-700"
            >Read more</a
          >
        </article>
      </div>
    </section>
  </main>
</Layout>
