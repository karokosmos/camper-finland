---
import "../styles/global.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import flag from "../assets/icons/finland_flag.png";
import teaInRepovesiImg from "../assets/images/tea_in_repovesi.jpg";
import { getCollection } from "astro:content";
import ReadMoreButton from "../components/ReadMoreButton.astro";
import { Image } from "astro:assets";

const allGuides = await getCollection("guide");
const landingGuides = allGuides.filter((guide) => guide.data.landing);
---

<BaseLayout>
  <main>
    <section
      class="mx-auto grid max-w-7xl gap-10 px-6 py-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-20"
    >
      <div class="space-y-8">
        <div class="space-y-5">
          <h1
            class="max-w-2xl text-4xl font-semibold leading-tight text-slate-900 sm:text-5xl"
          >
            Your guide to camping in Finland
            <Image
              src={flag}
              alt="Finnish flag"
              class="ml-2 inline h-7 w-9 rounded-sm align-baseline shadow-lg"
            />
          </h1>

          <p class="max-w-xl text-lg leading-8 text-slate-600">
            Discover helpful information, planning tips and travel inspiration
            for your next Finnish road trip.
          </p>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="/guides"
            class="inline-flex items-center justify-center rounded-full bg-sky-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-sky-700"
          >
            Explore guides
          </a>
          <a
            href="/about"
            class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-sky-700 hover:text-sky-700"
          >
            Learn more
          </a>
        </div>
      </div>

      <div
        class="relative hidden overflow-hidden rounded-[1.75rem] border border-slate-100 bg-white shadow-[0_24px_80px_-24px_rgba(15,23,42,0.18)] lg:block"
      >
        <Image
          src={teaInRepovesiImg}
          alt="Campervan parked by a Finnish lake"
          class="h-full w-full object-cover lg:h-[520px]"
        />
      </div>
    </section>

    <section id="guides" class="mx-auto max-w-7xl px-6 pb-20 pt-8">
      <div class="mb-8 max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700"
        >
          Guides
        </p>
        <h2 class="mt-2 text-3xl font-semibold text-slate-900">
          Start planning your camping trip
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          landingGuides?.map((guide) => (
            <article class="flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-[0_20px_60px_-28px_rgba(15,23,42,0.15)]">
              <div class="relative flex h-full flex-col">
                <a
                  href={`/guides/${guide.data.slug}`}
                  class="absolute inset-0 text-[0px]"
                />
                <Image
                  src={guide.data.mainImage}
                  alt={`${guide.data.title} cover`}
                  class="h-44 w-full object-cover"
                />
                <div class="flex flex-1 flex-col p-6 pb-10">
                  {/* <p class="text-sm font-semibold text-sky-700">Summer route</p> */}
                  <h3 class="mt-3 text-xl font-semibold text-slate-900">
                    {guide.data.title}
                  </h3>
                  <p class="mt-3 text-sm leading-7 text-slate-600">
                    {guide.data.description}
                  </p>
                  <ReadMoreButton href={`/guides/${guide.data.slug}`} />
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!--<div class="text-center">
        <a
          href="/guides"
          class="inline-flex items-center justify-center rounded-full bg-sky-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-sky-700"
        >
          All guides
        </a>
      </div>-->
    </section>

    <section id="about" class="mx-auto max-w-7xl px-6 pb-32 pt-6">
      <div class="mb-8 max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700"
        >
          About
        </p>
        <h2 class="mt-2 text-3xl font-semibold text-slate-900">
          Created by a fellow camper
        </h2>
      </div>
      <div class="text-lg leading-8 text-slate-600">
        <p>
          Camper Finland is a practical guide to exploring Finland by road.
          Created by a Finnish camper enthusiast, the site shares firsthand
          experience, practical tips, and useful information for camping and
          road trips around Finland.
        </p>
        <br />
        <p>
          Whether you're traveling by motorhome, camper van, caravan, or tent,
          you'll find ideas and information to help you plan your trip and enjoy
          Finland's nature with confidence.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
